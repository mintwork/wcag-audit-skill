{
  "name": "@mintwork/wcag-audit-skill",
  "version": "0.2.0",
  "description": "Accessibility (WCAG 2.2) audit skill for AI coding agents, plus a CLI: static source scan, real-browser runtime scan (Playwright + axe-core), verified findings, JSON and SARIF output.",
  "type": "module",
  "bin": {
    "wcag-audit-skill": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "integrations",
    ".claude-plugin",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "demo:gif": "npm run build && node scripts/demo-gif.mjs",
    "test:watch": "vitest",
    "prepublishOnly": "npm test",
    "prepack": "npm run build",
    "build:agensi": "node scripts/build-agensi.mjs"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "axe-core",
    "playwright",
    "sarif",
    "agent-skills",
    "claude-code",
    "codex",
    "cursor",
    "ai-agent",
    "audit"
  ],
  "license": "MIT",
  "dependencies": {
    "@babel/parser": "^8.1.2",
    "axe-core": "^4.14.0",
    "playwright-core": "^1.65.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mintwork/wcag-audit-skill.git"
  },
  "homepage": "https://github.com/mintwork/wcag-audit-skill#readme",
  "bugs": {
    "url": "https://github.com/mintwork/wcag-audit-skill/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
